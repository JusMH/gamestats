# Root context shared by all three Dockerfiles. Deny by default.
**
!go-ingestion/
!go-ingestion/go.mod
!go-ingestion/cmd/
!go-ingestion/cmd/**
!go-ingestion/internal/
!go-ingestion/internal/**
!simulator/
!simulator/go.mod
!simulator/cmd/
!simulator/cmd/**
!simulator/internal/
!simulator/internal/**
!scala-analysis/
!scala-analysis/build.sbt
!scala-analysis/project/
!scala-analysis/project/build.properties
!scala-analysis/project/repositories
!scala-analysis/project/DockerPackaging.scala
!scala-analysis/src/
!scala-analysis/src/main/
!scala-analysis/src/main/**
!docs/
!docs/examples/
!docs/examples/profiles/
!docs/examples/profiles/*.json
# Explicit sensitive/local exclusions also apply inside source directories.
**/.git
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials*
**/.aws
**/.codex
**/.agents
**/.cache
**/.tools
**/target
**/bin
**/evidence
**/coverage.out
**/*.exe
**/*.test
**/*.log
**/*.tmp
**/.idea
**/.vscode
**/.bsp
**/.metals